# ---------------------------------------------------------------------------
# Environment variables
# ---------------------------------------------------------------------------
#
# This app intentionally needs NO environment variables to run.
#
# Credentials are supplied by the user at runtime and are encrypted in their
# browser, so there is no server-side secret to configure. The proxy routes are
# stateless: the TeleBotHost key arrives per-request in the `x-tbh-key` header.
#
# Copy this file to `.env.local` only if you add server-side features that need
# configuration. `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# Optional: override the TeleBotHost API base URL (e.g. for a staging API).
# Defaults to https://api.telebothost.com/api/v1
# TBH_API_BASE=https://api.telebothost.com/api/v1

# Optional: request timeout for upstream calls, in milliseconds.
# TBH_REQUEST_TIMEOUT_MS=20000
